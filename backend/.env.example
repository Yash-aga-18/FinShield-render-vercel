# ============================================================
# FinShield backend configuration
# ============================================================


# ---------- Server -------------------------------------------------

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174
TRUST_PROXY=


# ---------- Database ----------------------------------------------

MONGODB_URI=mongodb://username:password@host:27017/database?authSource=admin

REDIS_URL=redis://127.0.0.1:6379


# ---------- JWT / auth tokens -------------------------------------

JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12


# ---------- Input validation ---------------------------------------

NAME_MIN_LENGTH=5
NAME_MAX_LENGTH=100

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

OTP_CODE_LENGTH=6

ADMIN_LOGIN_REQUIRES_SMS=true


# ---------- SMS ----------------------------------------------------

SMS_PROVIDER=android_gateway

SMS_GATEWAY_URL=http://localhost:8080
SMS_GATEWAY_USERNAME=your-sms-gateway-username
SMS_GATEWAY_PASSWORD=your-sms-gateway-password
# SMS_GATEWAY_DEVICE_ID=your-device-id


# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=your-twilio-phone-number


# ---------- Sessions ------------------------------------------------

MAX_ACTIVE_SESSIONS=2


# ---------- Single-window policy -----------------------------------

MAX_APP_WINDOWS=1
SESSION_IDLE_TIMEOUT=15m
SESSION_CACHE_TTL=7d
SESSION_REVOKED_TOMBSTONE_TTL=5m


# ---------- OTP / step-up authentication ---------------------------

OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=45s

STEP_UP_TTL=5m
TRUSTED_DEVICE_TTL=30d

PASSWORD_RESET_RESEND_COOLDOWN=2m
OAUTH_STATE_TTL=10m


# ---------- Login brute-force protection ----------------------------

LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW=15m

LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ACCOUNT_WINDOW=15m
LOGIN_BLOCK=15m

LOGIN_GLOBAL_IP_MAX_REQUESTS=60
LOGIN_GLOBAL_IP_WINDOW=1m


# ---------- Risk engine ---------------------------------------------

RISK_NEW_DEVICE_SCORE=20
RISK_NEW_IP_SCORE=10
RISK_FAILED_LOGIN_SCORE=10
RISK_TOKEN_REPLAY_SCORE=100

RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=100

RISK_ANOMALY_LOOKBACK=20


# ---------- Redis distributed locks ---------------------------------

REDIS_LOCK_TTL=5000
REDIS_LOCK_WAIT=2000
REDIS_LOCK_RETRY=50


# ---------- Admin ---------------------------------------------------

DEFAULT_ADMIN_EMAIL=admin@example.com


# ---------- API list sizes ------------------------------------------

USERS_LIST_DEFAULT_LIMIT=20
USERS_LIST_MAX_LIMIT=100

ADMIN_SESSIONS_DEFAULT_LIMIT=50
ADMIN_SESSIONS_MAX_LIMIT=100

HISTORY_DEFAULT_LIMIT=20
HISTORY_MAX_LIMIT=100

ACTIVITY_EVENTS_DEFAULT_LIMIT=20
ACTIVITY_EVENTS_MAX_LIMIT=50


# ---------- Google OAuth --------------------------------------------

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback


# ---------- Email / Brevo -------------------------------------------

BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=FinShield <your-email@example.com>


# ---------- Development-only switches -------------------------------

DEV_EXPOSE_RESET_LINK=false