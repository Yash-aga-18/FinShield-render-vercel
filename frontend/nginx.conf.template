# nginx config template — ${BACKEND_UPSTREAM} is substituted at container
# start by the official nginx image's entrypoint (envsubst).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: every non-file path falls back to index.html so
    # client-side routes (/login, /sessions, ...) survive a refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API and OAuth redirects go to the Express backend. Cookies pass
    # through untouched (httpOnly CSRF/auth cookies included).
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
